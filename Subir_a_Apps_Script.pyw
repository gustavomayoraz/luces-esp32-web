            "UART": "#c026d3", "FLASH": "#b91c1c", "ARRANQUE": "#b45309", "SOLO": "#be123c"}
_CLASICO_ADC = {36: "ADC0", 39: "ADC3", 34: "ADC6", 35: "ADC7", 32: "ADC4", 33: "ADC5", 25: "ADC18", 26: "ADC19",
                27: "ADC17", 14: "ADC16", 12: "ADC15", 13: "ADC14", 15: "ADC13", 2: "ADC12", 4: "ADC10", 0: "ADC11"}
_CLASICO_TOUCH = {4: 0, 0: 1, 2: 2, 15: 3, 13: 4, 12: 5, 14: 6, 27: 7, 33: 8, 32: 9}
_CLASICO_BUS = {23: ("SPI", "MOSI"), 19: ("SPI", "MISO"), 18: ("SPI", "SCK"), 5: ("SPI", "SS"),
                1: ("UART", "TX0"), 3: ("UART", "RX0"), 17: ("UART", "TX2"), 16: ("UART", "RX2"),
